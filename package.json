{
  "name": "chain-diff",
  "version": "0.1.0",
  "description": "Git diff for onchain state",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "ethereum",
    "defi",
    "aave",
    "morpho",
    "onchain",
    "cli",
    "blockchain",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@morpho-org/blue-sdk": "^6.11.0",
    "@morpho-org/blue-sdk-viem": "^5.7.0",
    "@morpho-org/morpho-ts": "^2.15.0",
    "commander": "^15.0.0",
    "viem": "^2.56.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "bin": {
    "chain-diff": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saldfsdk/chain-diff.git"
  },
  "homepage": "https://github.com/saldfsdk/chain-diff#readme",
  "bugs": {
    "url": "https://github.com/saldfsdk/chain-diff/issues"
  }
}
